{
  "productName": "SPICA TIDE Deck Cargo Planner",
  "version": "3.30.0",
  "identifier": "com.spicatide.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Decargo — Deck Cargo Planner",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "\u00a9 2026 Decargo. Developed by Pavlo Lagutin. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "Deck cargo planner for offshore supply vessels",
    "longDescription": "Deck cargo planning for offshore supply vessels: plan, check and export cargo placement on deck.",
    "licenseFile": "EULA.txt",
    "fileAssociations": [
      {
        "ext": ["spica"],
        "mimeType": "application/x-spica-tide",
        "description": "Decargo Plan"
      },
      {
        "ext": ["json"],
        "mimeType": "application/json",
        "description": "Decargo Project (JSON)"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "SPICA TIDE"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/lagutinpavelglebovich-droid/spica-deck-cargo-planner/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NUQyMjBGMTNFQzM4NEYKUldSUE9Pd1REeUpkT1Fia3lvcU41NGFtMFRacDIrSUlRWjNEODkyb0xPQUJDL0NQUVI4azhOdUoK"
    }
  }
}
